# 이 파일을 복사해 server/.env 를 만들고 값을 채우세요. (.env 는 Git에 올리지 않습니다)

# MongoDB Atlas 연결 문자열
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# access token 서명 키 (충분히 긴 무작위 문자열)
# 생성: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=<random-hex-string>

# Cloudflare R2 (S3 호환)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET_NAME=<bucket-name>
R2_PUBLIC_URL=https://<public-bucket-url>

# development 또는 production
# production 이면 refreshToken 쿠키에 secure 옵션이 켜집니다. HTTPS 에서만 사용하세요.
NODE_ENV=development
